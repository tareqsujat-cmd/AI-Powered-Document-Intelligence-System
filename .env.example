# Copy to .env and change the values marked "change-me". Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# Database. docker-compose overrides POSTGRES_HOST to reach the postgres service.
POSTGRES_USER=docintel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docintel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: full SQLAlchemy URL, takes precedence over the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Redis (Celery broker and result backend). docker-compose overrides this.
REDIS_URL=redis://localhost:6379/0

# Host ports published by docker-compose. All bind to loopback only: the API has no login.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# API. Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Baked into the frontend at build time; must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Uploads
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=200
MAX_REQUEST_MB=1024
MAX_FILES_PER_UPLOAD=50

# Rate limits per client per minute, shared across API replicas. 0 turns a limit off.
RATE_LIMIT_UPLOADS_PER_MINUTE=30
RATE_LIMIT_SEARCHES_PER_MINUTE=120
RATE_LIMIT_REQUESTS_PER_MINUTE=600

# Worker
WORKER_CONCURRENCY=2
TASK_SOFT_TIME_LIMIT_SECONDS=7200
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY_SECONDS=30
STALLED_AFTER_SECONDS=900

# LLM. LLM_PROVIDER is gemini, or openai_compatible for any OpenAI-style API
# (set LLM_BASE_URL, for example https://api.openai.com/v1 or a local Ollama server).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# LLM_BASE_URL=
# Requests per minute per worker process, to stay inside provider quotas. 0 means no pacing.
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_CALLS_PER_DOCUMENT=1500

# Embeddings (local model, 384 dimensions, included in the Docker image).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OCR
OCR_LANG=eng
OCR_DPI=300
OCR_PAGE_TIMEOUT_SECONDS=120

# Spreadsheets: rows read per sheet. Rows beyond this are dropped with a warning on the page.
MAX_SHEET_ROWS=100000
