# Copy to .env and change the values marked "change-me". Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# Database. docker-compose overrides POSTGRES_HOST to reach the postgres service.
POSTGRES_USER=docintel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docintel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: full SQLAlchemy URL, takes precedence over the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Redis (Celery broker and result backend). docker-compose overrides this.
REDIS_URL=redis://localhost:6379/0

# Host ports published by docker-compose (Postgres and Redis bind to loopback only).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# API. Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Baked into the frontend at build time; must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Uploads
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=200

# Worker
WORKER_CONCURRENCY=2
TASK_SOFT_TIME_LIMIT_SECONDS=7200

# LLM (provider-agnostic; default is the Gemini free tier). Used from Phase 2.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Embeddings (local model, 384 dimensions). Used from Phase 3.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OCR. Used from Phase 1.
OCR_LANG=eng
OCR_DPI=300
